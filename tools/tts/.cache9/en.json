{"host/host.hello.0.ogg": {"h": "018b84434024e578", "m": [4778, "Ln7lpkoPVaZULMWNBBBABQn78tOMouxaeqlqvpolgbZRWXSGCBCDEFEDCCCBdqO99/bMRi50YImYUbabQUlvePVprsNPjypqnnnabgkpmjkcaeXSLHFFLXFA"], "t": "Good evening, welcome to Lumière. The box office is just inside, on your left."}, "host/host.hello.1.ogg": {"h": "c7415e993ac6a15a", "m": [4159, "CW22vT2tqmlicLDAAAACHqojOZrvvyrmHl4znSYWWMBBBBBBBBBAclfevPr+02wlm0/4iECRFXaVw2vMVXoZ4fKFc1viteSst42oHCNC"], "t": "Hi there! First time with us? Tickets on the left, snacks a bit further back."}, "host/host.hello.2.ogg": {"h": "2cf5eb1777f6464d", "m": [2246, "Il80Ip36rfUNaIBABBCQwbNxcYj73uvsl1uU131om/tYjVZYhdZSQUVDA"], "t": "Welcome in. Take your time, there's no rush tonight."}, "host/host.hello.3.ogg": {"h": "73e3351e9f6f224a", "m": [4617, "Fu44tMbjaTQMNFCBBAABBcxLPcz3584q06xtiHGhhntoWEBb6/8x4321uQOV42jr7wivcvzrpfWRJDBBBCCBCCCDEFFFEEEFEFFGGGIIHIIHHHHGIIHE"], "t": "Evening! If you need anything, I'm right here by the door."}, "host/host.hello.4.ogg": {"h": "2a4c2242190acc87", "m": [3660, "Ip275ywol55tNnyswqlZDBS/XYEOK631zqKUYutpkgYDBGXWxy1xfk1wOnsPNhXMfJVXXTQIBTaePBBAABBBBBBCCCDB"], "t": "Hello, welcome. It's quiet tonight, so you'll have your pick of seats."}, "host/host.back.0.ogg": {"h": "0db5e957d2730264", "m": [2658, "f6+/91siZifMo26zveRDBMHCAAAACdiiqyYDClkdtx2mUZRPorrmkgWRCirmhbQOSFB"], "t": "Oh, you're back! I hope the last one was good."}, "host/host.back.1.ogg": {"h": "0a30c4df1247a8be", "m": [3148, "OlrgJMp2vxqiXIBLLDABCCBIWWp603/yghDk487zmcc20ueXMTkllkkieOCBDYshigjbRovwrdSTRMB"], "t": "Welcome back. Same screen as last time, or something new?"}, "host/host.back.2.ogg": {"h": "83cdd0c1870960cf", "m": [3141, "BKg+91nGCt/WasYQbww2uuhOnoiWegKBBBBBBCCCCCBCCDEGHHJKJKJIKLJLMNMLKMNOQNNOKOMOQKJ"], "t": "Hey, good to see you again."}, "host/host.tickets.0.ogg": {"h": "3075c310e926d843", "m": [4437, "BpnT578mFaWkohTHYjdVUMbcLHsjejs1810zePUnrqmXbnsssqnnmftxmUMGHIBWFCCCCBBBCXwlfVfV6/rt077zbcWHX21y01zom0wuuZIOXMC"], "t": "The box office is the long counter on your left. Just tell them which film you want."}, "host/host.food.0.ogg": {"h": "94c23582ccb04986", "m": [4580, "LX67UDWP3/87421bjsqpnZZiyweIeMSfuvyxxzyyztqxwoaMIIPELZz4kZZGlg1uaGZVffSETIVYaaZKBBBABBBBEDDDDCCCCDDDDCCEFFEFFGIMIHG"], "t": "Popcorn and drinks are at the counter on the left, past the box office."}, "host/host.wc.0.ogg": {"h": "3de5232693f990b8", "m": [2864, "Bhpr/olIVu00lptssnlgftqrhWGRICBBBBABTc70eWBSmvtlWXKepjhQRDZhgcUSRPLcWRJB"], "t": "The restrooms are on the right, just past the escalators."}, "host/host.gate.0.ogg": {"h": "ddc01ee07310280f", "m": [3811, "ClwyYerbQz/mgniGchiKUfeWDGBAANZch644jTbZjoyxfeZpggqkcnopfcNMfggePUTOSZUNCBBBBFZgQVfoPMnu02eKGJEA"], "t": "Once you've got your ticket, show it to the usher by the escalators. He'll take you up."}, "host/host.bark.0.ogg": {"h": "1718a6026cb6249e", "m": [1854, "BducombXlhffVdfZaZWZVHBAAAAAABBBBf/kr0x221yynIA"], "t": "Good evening, everyone."}, "host/host.bark.1.ogg": {"h": "09ea37e635487a26", "m": [2529, "XvwxzypaUUwtRJFkmlmplgcUTtKhndx/uPduytmqjSTUVffXTRLICBAAABBDFFEC"], "t": "Mind the step there, it's a bit wet outside."}, "host/host.bark.2.ogg": {"h": "7935932d6cf6e2a7", "m": [2295, "Bkyy/81mjskTq2mEaiaSQUGQUsy0vuppplbSPUQDBABBBBBBBBBBEBBEJA"], "t": "Doors are open, come on in."}, "host/host.bark.3.ogg": {"h": "3fb5818de3d59810", "m": [2100, "Mp6udy22umppSsnZHVYROMSIBABBBBBBBBBBBf9/8x83Qi24rPwwl"], "t": "Enjoy your evening."}, "box/box.hello.0.ogg": {"h": "ae9080ff0f981933", "m": [1843, "DMj73ndXUQIAAAd3uEVit1zgQ4/MOVWMMXSZZVTROHAQSDA"], "t": "Hi, what can I get you tonight?"}, "box/box.hello.1.ogg": {"h": "6130951843348445", "m": [3700, "KVNRYVPDNRPNMJDAAAABBBAABXmcMjNHfplipsngYXTXROVXWOONLEAACBAAAAAABBBACCBBBADr0+/4zz1dMRZhidbWJ"], "t": "Good evening. Which film are you seeing?"}, "box/box.hello.2.ogg": {"h": "d1f2753970f93c36", "m": [3300, "IfnlrmfdbYTOGBAAAAASfy8/63xZUjlSt4wYGZUYZogfSBKeZMHXZhXgcthLXSXpiccZTlcFOUgeYWVSOHA"], "t": "Hello! Do you know what you'd like to watch, or should I tell you what's on?"}, "box/box.pick.0.ogg": {"h": "4d67d851db888a48", "m": [3130, "DU4olx/iNkTEGdeeSJPmkhiiSZQcgebaWRIObFABBBAAAALt1l3w0QOaHRbgicPesohcZUPEBAABBDB"], "t": "Here's everything playing tonight. Have a look at the screen."}, "box/box.pick.1.ogg": {"h": "7e1f953563ae121f", "m": [3069, "BZkYDf5PIHIQ4/1ZceSSmljgYXSQOXbbaYYPCMAQcUQghQLYMfqmkYXeggOMYPSgQHHLZVTPIBOIA"], "t": "We've got four screens tonight, and each one is a little different."}, "box/box.fmt.MAX.0.ogg": {"h": "8b6c8a0a484038e8", "m": [4606, "BXo13qaFFNUOCcUasmaCCruKVYPZXbDUeZSQPOJAAAAAABBDiXGFZ/84kjfsXNMTs4vlVScnutedZWQBBCCBDenkfXWXospmgaaUVWNLVWTPONFJVQDA"], "t": "MAX is our biggest screen. It fills your whole view, and the sound is huge."}, "box/box.fmt.CURVE.0.ogg": {"h": "4e428a168bc32647", "m": [5287, "JMb344ZijWfnkdUiHLMSiebYWTSQJVUVLBAAAAKmNaTDYVw992utscYUkobJIRJCegXPCABDECCEuw2velhMi/xumQPk0pUcfdt5xxooYVeiYZUKSQYUMFABBABBBBBCCCEEB"], "t": "CURVE is all recliners. It's calm and comfortable, and the screen curves around you a little."}, "box/box.fmt.CLASSIC.0.ogg": {"h": "31a8e6de8d5cdd6a", "m": [5039, "JN/9cVcceCObRJZcTcRSnlwwpYcaZZYaYWVQDBAAABBBBAAU24XSggfturjJIdVFt9zRCNPg11lQRcYhhfYPY7uRy4ulPVdcnllliWHIWgmffbXXTHBDFGEABBCBIH"], "t": "CLASSIC is the traditional one. Good seats, red curtains, that old cinema feeling."}, "box/box.fmt.X270.0.ogg": {"h": "b76fb6c1a9095de6", "m": [5817, "GZeWWTrqQedXQXUXTTVTPQmWwrifeYBKSWWWqppiNDTWSOLJQTVMBAAAAAANhsqVF/iDTXPTnrnhdYYUUMDVBNhaBagYVTCismQRjpifSXQJXaVVTMBABAABBBCCCDDDHGFFEEFGGHHHIGFEEC"], "t": "270 is the one with the side walls. In the big scenes, the picture spreads onto them."}, "box/box.seat.0.ogg": {"h": "ae7abd067309f0b3", "m": [3013, "Dhq018e7/ufz81rqfaVVrebUBEwoSPbgeXCZqicIBVTUINbmjmdOTUHcYUTRMEAABBBBBBBABCEB"], "t": "The middle rows are the best spot, if you ask me."}, "box/box.seat.1.ogg": {"h": "eb89cf388bd08a68", "m": [3931, "BmxpXEa520eGIOfkiXk75yjaaSIRYYUCRlkqqSAJICACEFDABdqfZcijRBf/1Oi0nFEgklikNrueCLaThgebbdcaVOOUcaWIQFB"], "t": "I'd go a few rows from the back. You see everything without turning your head."}, "box/box.seat.2.ogg": {"h": "a36afb1a7da4740b", "m": [2343, "BZiQaurokaRv/0jLltsmrsrjUidXNBAAAAAPhmpqZx6vqPbTZcaUEAMVPGC"], "t": "That one's right in the middle. Do you want it?"}, "box/box.tablet.0.ogg": {"h": "79f41a8b6c373995", "m": [6700, "EJpvu52qondUZoqrqkntvxsogbaXOCAAAAAUzeZeGcXXc8qDXfkWCXjkjhmkSqtwqmhacVOHNUYWSLYIBBBBBBCBBciMf1mZt+/ekPKIX22vjfSPHfeuxrFDOJmntjiebaZaYXZbaWUQIBBBBCCDFPLKKKKIGFEEDACLLKKI"], "t": "For ninety-nine more, there's a tablet in your armrest. You can order food without calling anyone."}, "box/box.tablet.1.ogg": {"h": "a84ffa1c2c39220c", "m": [3914, "BRmfKVfepsoXDPRSRTWTIBPLVYDFRURKAAQICAAAABBBABUhgQq+/skgJRlfiecVZUSUWSNHKJBbdffdNCZfabTUMXaXSESUPI"], "t": "Would you like the seat tablet? You order from your seat and they bring it over."}, "box/box.paid.0.ogg": {"h": "a6ca79d2c045e9c4", "m": [1571, "Cw/nPhFm1rhMIQlyljePFAAAADJxxohGPLegaSHA"], "t": "That's gone through. Thank you."}, "box/box.paid.1.ogg": {"h": "9a950e6f40617686", "m": [1587, "CkokXVOlkZCBFbaXTOJHOVUNCAAABBABAAFJ/3xs"], "t": "All set, thanks."}, "box/box.ticket.0.ogg": {"h": "7ec2d3f1c84de211", "m": [3620, "Ei37gcahRJdTeJJObQCCTOEAAABAGbmj+/zxbeaVHjHSwulRCUwqZigtlRXYDQjkkfSCUKcdUNSQNFBBCCBBBBCBCIE"], "t": "Here's your ticket. Show it at the gate by the escalators."}, "box/box.ticket.1.ogg": {"h": "37f610b1e072ef16", "m": [2677, "HoqqkkSNnnhbaULBAAAABBAABehE14l1zmps/2LrjldLLWUBVPKIfneYdQOotmkbYUB"], "t": "There you go. The usher will check it before you go up."}, "box/box.bye.0.ogg": {"h": "4961bb032053e4d0", "m": [2300, "Mhppch56qaTKIIgleYUTSPEAAAABCDCBBAAXw8wjp3/25XgQJJmxzvqmne"], "t": "Enjoy the film."}, "box/box.bye.1.ogg": {"h": "0b0764ade0cb95a2", "m": [2180, "GgQdmfffm87gHNbjaLNbbaTITZXWUSKAAAAAIwfuwt/2OKcZLVbYPJH"], "t": "Have a lovely evening."}, "box/box.bye.2.ogg": {"h": "622c6673b979475e", "m": [2818, "CclpbZdjefcaXPFAAAABCCCBhrtfQk7/3wFUXchxmCKrnDDBQcohgihffegjVjqgddZWSHB"], "t": "Enjoy, and grab some popcorn on your way."}, "box/box.again.0.ogg": {"h": "60933d3d63f033ae", "m": [2807, "BcfUpv0/ytkNumOYRBiZiFOgVEITOdRZbbZWRLBQUFAAAAABcrxw0nbdenrsSqglqxnqbEB"], "t": "You've already got a ticket for tonight. Do you want another one?"}, "box/box.again.1.ogg": {"h": "aac97b142fce60ee", "m": [2977, "BWl3MXeQn8yPHOUhnYWrjePGCl2mUBNMNZKCAAAABhw6/wJdprtrbcaqXKXdZZklTBHu7qQHHFB"], "t": "Looks like you're all booked. Anything else I can help with?"}, "barM/bar.hello.0.ogg": {"h": "087ccce763f3f3f4", "m": [3160, "Fn25xnbXRKDBAAAQyjOpuvsZu0mMSXXWSJDCCCAAAABBBBCUryvlhZVQPMCBAACDDDCCCCe/2HRzywy"], "t": "Hi! What can I get you?"}, "barF/bar.hello.0.ogg": {"h": "6e2df914062829bb", "m": [1499, "HOn0sshbUUHECCBAAZ63FNu/3ybsrbMhhZRNIE"], "t": "Hi! What can I get you?"}, "barM/bar.hello.1.ogg": {"h": "d02e043345ec2de2", "m": [1453, "BUxzvdmrhbXSJDBCCCCBBBPu/qEEWturplaHC"], "t": "Evening. Popcorn?"}, "barF/bar.hello.1.ogg": {"h": "41396257422f71d5", "m": [1942, "Cn0xrRIeZVMMQGDAABBCBCCBBBKZs/qFHPTt0yzxwmMEBDEEC"], "t": "Evening. Popcorn?"}, "barM/bar.hello.2.ogg": {"h": "d48ff2e8932b30a2", "m": [1730, "Ry/5YrtokgWSmsjur4ZLimjdVMEDCCCCBBBBBCBECGDB"], "t": "Hey there, what'll it be?"}, "barF/bar.hello.2.ogg": {"h": "a482ed81b389371e", "m": [1377, "Fl/ze4yqhaUQKAABBa04iuxumMIgeZZXVGA"], "t": "Hey there, what'll it be?"}, "barM/bar.what.0.ogg": {"h": "1f347b3a24751dc7", "m": [3576, "Ca6zXk91OTfn899jUw2yUWMDCCCCNV1xxpokkgZXabundXUPOVRKECBCBCVz/si6toomjYPEDCKZfagvwtkZPHROGD"], "t": "We've got salted, caramel and cheese. Regular or large?"}, "barF/bar.what.0.ogg": {"h": "b51b0a20da14d87d", "m": [3832, "DblaFNnnHHJKipoaOaipmdVQBAAADKJhlmovponmiTgrpSbZQWTONIOORDABBBBAAHh0uUe/xprpnlgKturoqkmnfdiWHUWR"], "t": "We've got salted, caramel and cheese. Regular or large?"}, "barM/bar.what.1.ogg": {"h": "a9626fd08a404af3", "m": [1104, "Bj4/6mLwvfYaNi10mLotLo1yrfLB"], "t": "Anything to drink with that?"}, "barF/bar.what.1.ogg": {"h": "4593d32eedb93bde", "m": [1880, "DDhuthGRbcSRYTSbeheHbPBUYVRQCPKBAAAABAABBBACMu/"], "t": "Anything to drink with that?"}, "barM/bar.combo.0.ogg": {"h": "8d60fb78694e451f", "m": [3068, "DdcQt93u2/ytxlVanvqJQXanbJoqnXGTYQjbeecSOdhaSCRPeebSMGCCCCCBBBBBBBBCHFCFGCHIA"], "t": "The combo works out cheaper if you're getting a drink too."}, "barF/bar.combo.0.ogg": {"h": "cc98c0b970712075", "m": [2618, "DjRWRT1+/83+8zk72YYQl4zfDZmilvQLnmlgINpdNtry41wUarzrNDkduwleYUaLEB"], "t": "The combo works out cheaper if you're getting a drink too."}, "barM/bar.combo.1.ogg": {"h": "e6c359cbc58a7262", "m": [2836, "CHp55tz/+43w477tsgJcomnmSWjghbinidYPJRSOHDCCCCCDj482gHTymLrvTRkz74qmVNE"], "t": "For a little more you can make it a large. Most people do."}, "barF/bar.combo.1.ogg": {"h": "b1125c88844cfcf4", "m": [3222, "DRnllmlqfkmotrphcdYVVUbKJaklkbDQUWVRRUUSMKDFVUHAAAABBBBBBCp/6ePGBGSWCcpZObcZSLLGC"], "t": "For a little more you can make it a large. Most people do."}, "barM/bar.ready.0.ogg": {"h": "5e5bb4b5aca0d0ab", "m": [2076, "INh890urYkvzwrbNEECKMQ9/sKK293jPpWalcTz3zscfkhebSSND"], "t": "Here you go. Careful, it's still warm."}, "barF/bar.ready.0.ogg": {"h": "87babb3a7baa195a", "m": [2378, "EL1/7w10TniaVRHDAAACCBQq1zcHgvtnfULDYuaGLLUg0vsmuyyyxohdUFDA"], "t": "Here you go. Careful, it's still warm."}, "barM/bar.ready.1.ogg": {"h": "8afc95be0955b337", "m": [2387, "CPd9/47uqux3tpnbRNJFCCCCCCCCSinu11THN4zvfqtwtnnmdaXhniZTQJHE"], "t": "There you are. Napkins are on the side."}, "barF/bar.ready.1.ogg": {"h": "bc4603a7b19def59", "m": [2568, "EZd62wnifYQXVVeddbVXXPDAAABDBCEk9/9xHBK014okqxumjqodMWmkkgbURINEB"], "t": "There you are. Napkins are on the side."}, "barM/bar.ready.2.ogg": {"h": "76131132d62f976e", "m": [1885, "Di2pfrZSjlcTJJHFCCCCBBCPWYMg03/zefjomiNCbiedSJFB"], "t": "Here's your drink. The straws are right there."}, "barF/bar.ready.2.ogg": {"h": "16a2cdc3f57552b7", "m": [2094, "JR193umi/vWVefWOGLJEBCBABEI2mkYT+9++ovxjyypdCdjdVQIGC"], "t": "Here's your drink. The straws are right there."}, "barM/bar.bye.0.ogg": {"h": "8fbe18973ed164fb", "m": [945, "CfoofVp9/+8hyjebenneXPID"], "t": "Enjoy the show!"}, "barF/bar.bye.0.ogg": {"h": "cd2905390aa95e6e", "m": [2131, "Zz52jdslkghNaZaZRVRNKHJCAABBABCDDCBCp/SceWNrwtpgYRUSEA"], "t": "Enjoy the show!"}, "barM/bar.bye.1.ogg": {"h": "cb25928ce6c994d4", "m": [746, "CNkpUdSP2/mdggbRNJC"], "t": "Have a good one."}, "barF/bar.bye.1.ogg": {"h": "eb79c3fbaf171fc8", "m": [1580, "M/j0kOwsPWebcYXQJBABBBBBCCCCCCl9yjgcaSJB"], "t": "Have a good one."}, "barM/bar.bye.2.ogg": {"h": "4558fba3fac19874", "m": [561, "CfofXp025/1mRFA"], "t": "Enjoy."}, "barF/bar.bye.2.ogg": {"h": "984b2113ba68d877", "m": [1560, "Pw6ucu2wrgZUOIDAAABBCR/0yxz1rXhojebTPOG"], "t": "Enjoy."}, "barM/bar.bark.0.ogg": {"h": "3657e28fa0be06ee", "m": [1289, "DHt/4laGv+9qNanv4sWDOknljkhcXXUEB"], "t": "Fresh batch out in a minute."}, "barF/bar.bark.0.ogg": {"h": "079d161045f00153", "m": [6010, "EavqecVHCerrlWTVHiqmiJXkqmngXWQMETNCAABBBBBBBAU1/+9wuxz23wqpfCGSfJCIYdcbXUQQHJCABBBBBBBBBBCCEFGGGHHIJJJKIJIIKMPOMPNNMMMMLONMMNMKJJIGHFCCCCDDEGJOMPPNPOE"], "t": "Fresh batch out in a minute."}, "barM/bar.bark.1.ogg": {"h": "5b21bc9e53d792fb", "m": [664, "Sw/qQkFMgjbSUaUHC"], "t": "Next, please."}, "barF/bar.bark.1.ogg": {"h": "dc7802fc79ec4b8f", "m": [856, "W/+lOWOhVBJNfWRaYVRXGA"], "t": "Next, please."}, "barM/bar.bark.2.ogg": {"h": "79b4f3f94eb6e047", "m": [679, "Dn8xho49/wKZiKWLF"], "t": "Who's next?"}, "barF/bar.bark.2.ogg": {"h": "5395d9987376d90c", "m": [1419, "Dg3ljxscDNPCQBABBBBBBBCDBD6/qJPNNNIB"], "t": "Who's next?"}, "usher/ush.ask.0.ogg": {"h": "9f9ff93689503552", "m": [2390, "K0rpwtrgqniecZXWSIBBAABBBABl/wukScvqnieaYqspopnjQCQweImlLMHC"], "t": "Good evening. May I see your ticket?"}, "usher/ush.ask.1.ogg": {"h": "c38cd98d2b46a597", "m": [822, "O8wMlcFBJR/+z1yvhaWIC"], "t": "Ticket, please."}, "usher/ush.ask.2.ogg": {"h": "45f64fe61a399dab", "m": [1558, "CP23siWSQHGY/1xrf1uYu12pPyoo5dTV5iM0nTG"], "t": "Hi, can I take a look at your ticket?"}, "usher/ush.check.MAX.0.ogg": {"h": "4b43b917d294343f", "m": [2325, "Cn7yngQDVaYTIBAABBCCDCBAY/gYjyjeffOo60tqjgbsz1wwyyqjYMHBIDA"], "t": "MAX. That's upstairs, on the left."}, "usher/ush.check.MAX.1.ogg": {"h": "069504ce133ad6f6", "m": [3620, "HmqqmiefcUGRaXPIDAKx2lwsroqssmjgebYmrnomglkfjmljfJCAAAABBBCEEDCBBABm/dZdYWurponqXFBf2yvuuue"], "t": "Ah, MAX. You're going to love the sound in there."}, "usher/ush.check.CURVE.0.ogg": {"h": "978f4cfca5f412c5", "m": [3780, "HU/xlWPMJLMMIBAAAR2tRVeeK26xpYOMJMTSKDf1lJHr870vw0v51pvpzvt6vlVSJBFJFBCEEDCCAR36zuu6zrVCGHXRJHD"], "t": "CURVE. Upstairs, and all the way to the back. I'll walk you."}, "usher/ush.check.CURVE.1.ogg": {"h": "53c92dd9bab24b3a", "m": [4067, "CXc50vncUPLKKHBAAABCBAE/+3rl2oOTm+zxywvlp2tn2wvtbLWz11fQDagVZSOGBCCBAFha37yuvxtoTOnwPMr2uurffcXVxugTKD"], "t": "CURVE. Those recliners are very comfortable, try not to fall asleep."}, "usher/ush.check.CLASSIC.0.ogg": {"h": "6ecce98b8ac47839", "m": [2322, "CaV44wuddadPHHEAABCBBABm3XfgXK/4uhYTPQYWMEEZ9575y13wmcRKMEA"], "t": "CLASSIC. Upstairs, on the right."}, "usher/ush.check.CLASSIC.1.ogg": {"h": "9752031367de2f82", "m": [3060, "S/uokbaXcLFFBCEFEDBAAJ7ulQXWFv3x30w2zvYGlaNS13hQHPSPHOSPGAAAAAACDEEGIHIHGHIKJ"], "t": "CLASSIC. That's the one with the curtains."}, "usher/ush.check.X270.0.ogg": {"h": "2937d80934da32ba", "m": [2931, "Iz/scdv4wqpjWRQNGCAAAK9vaecNU84wniecYdkpnmruy2zvjbPGDaQQmOJt3xwty1wlXTRKEB"], "t": "270. Upstairs, on the right, at the far end."}, "usher/ush.check.X270.1.ogg": {"h": "7582c2f42de3cdec", "m": [4282, "G2/ngh20odiYPQPLGDBAAACEEDANgjk+lGCr73zuw3465vYeURNGBBfymjle7zwuusov63ywyzpZl55taPXOy2tjbaKMJvzxuuxwphVSOMEA"], "t": "270. Sit near the middle, the side walls look best from there."}, "usher/ush.tear.0.ogg": {"h": "42ae9978769728db", "m": [1604, "L/0yvlv2uggPE7zwofZNBAABR88q4zy1pPHHaULEA"], "t": "Here's your stub. Keep it with you."}, "usher/ush.tear.1.ogg": {"h": "217577110d6fbe0e", "m": [1699, "Ct7720wo/7zpcYRb891y7302sl2s1zleU+3rdVOLLGA"], "t": "All good. Hold on to this half."}, "usher/ush.lead.0.ogg": {"h": "8ad23111b7453d27", "m": [995, "F/63230w0woGNi982sokddXMC"], "t": "Follow me, please."}, "usher/ush.lead.1.ogg": {"h": "bc89027d87e3d892", "m": [2708, "J8znXMmsjZVRICAABj7nUeRQ/2oVDe1sroheTHdqmjhXNQMHBABBBAAABCCBACBAABFD"], "t": "This way. Let's take the escalator."}, "usher/ush.lead.2.ogg": {"h": "0c110ebe2c05c72b", "m": [1931, "NU+/wpfVUZnsgaauvslcRNJDBAAAAAATOCABDDBBBBBBBAADA"], "t": "Come on, I'll show you."}, "usher/ush.walk.0.ogg": {"h": "a9791d851152fa55", "m": [2847, "BOLq3pmneNBIuzrjVFBOXckicYUNDBAABBBAP/1Rc2cEBitgSsvnTWm2spsmcVMTjqdWPNFA"], "t": "Quiet night tonight. You picked a good time to come."}, "usher/ush.walk.1.ogg": {"h": "54b1c14055002a6c", "m": [1509, "Bi8w/4xw320aqvv5thaCo432xnrTLgxtyuqiHC"], "t": "Have you been to this screen before?"}, "usher/ush.walk.2.ogg": {"h": "18a23fc8fb00decf", "m": [4580, "PUIT3xpokdrpqlcTOM0uprlTJmqomkTCKkxkNDXWOTRQOJDAAAAAABCCCCBq/vVUuumjmnkbOtoPHg000yfcLTfupkQCIlhLIfyqoflZPNrwsnfWTPF"], "t": "The corridor's dark on purpose. Your eyes get used to it before the hall."}, "usher/ush.walk.3.ogg": {"h": "5f3313f4945bcfa0", "m": [1460, "Q3/7933thXGZ33ynaXRMFCAAABBBo+57851kc"], "t": "Almost there."}, "usher/ush.walk.4.ogg": {"h": "50d7a6c3cf2ae2b7", "m": [2388, "I6xQQQ/0lgZTaZZWSMFBABAAAFlkO30Vdp2fp3jIBq9zvmMKdnZNkkhYSLGD"], "t": "Stay close, it gets a bit darker here."}, "usher/ush.walk.5.ogg": {"h": "ed7b0d23a0b825b1", "m": [1090, "Bw5WXPGb/zeYL3xZFkhhrkcUPJEA"], "t": "It's just up ahead."}, "usher/ush.stairs.0.ogg": {"h": "eac30799d7769515", "m": [2460, "Hq/vTLp21zyyzxthgYDw5iMEWWHysRSt8kYlkdjrgkt1wbHJEBAAAABBAAH+5n"], "t": "Careful on the steps, the edges are lit."}, "usher/ush.stairs.1.ogg": {"h": "87422cfa335e8f1a", "m": [1557, "MwzkMIcdvyhdcQK/nNDAJ1zwvuxoeytromkeTNE"], "t": "Watch your step going down."}, "usher/ush.seat.0.ogg": {"h": "c2b65afd9945a3be", "m": [2049, "Cy1vsqppollfXPLGBAAAAABBBAAW/xcVu2wqoy1xwskYQMYZYLDA"], "t": "Here you are. This one's yours."}, "usher/ush.seat.1.ogg": {"h": "9b302c7d9ccf99cb", "m": [1837, "DYqpbXeqlovpdcaanzmTHJHBAAAAABq/90ek3uqunXSNJB"], "t": "This is your seat. Enjoy."}, "usher/ush.seat.2.ogg": {"h": "eca08ae91bfd8c60", "m": [2042, "Fozzyja/53ykUNDABCCBBBu9vmUKI38520y1xzy54tgZVafbXMCA"], "t": "Right here. Best view in the house."}, "usher/ush.phone.0.ogg": {"h": "6f02d610e5ac20a9", "m": [2697, "DL/1z011m1wuvqfab3xvwtoliaMGXqvhcTFtsuxspZYXDn8wkzvvurroSIHtponmaRFA"], "t": "Phones on silent once the lights go down, please."}, "usher/ush.phone.1.ogg": {"h": "91feb2faa8bc948b", "m": [3449, "RjPQs/7+865r0y100WO20yyxuscDJn7xnZIe0egt3yrp0mWDF7xhHQpvraGSuveagzz40xvpiiaDOW8qfZWQMFA"], "t": "If you need anything, press the service button and someone will come."}, "usher/ush.enjoy.0.ogg": {"h": "2ef69706c73cdffc", "m": [1052, "Bq+/4jex0yxwirfOJs6tiYVSMGB"], "t": "Enjoy the film."}, "usher/ush.enjoy.1.ogg": {"h": "93e4f7fabbb3a0c3", "m": [2660, "Izrvodn/zjhgc5vngYSJCBAAAAABDDDDDDCCCDDDDDDDDDDDAAACEFFEFGFFFFGEEEE"], "t": "Have a good show."}, "usher/ush.enjoy.2.ogg": {"h": "4eb27cbe4dab8f03", "m": [4374, "Be00xiTag/xsogdWUQLDBABCEFDCCx25xbYOBAaxzuqookaTNDBAABBBABrrJDitnopmqueMKpxnhWp4srstsulutoghledSHKwvutpfZVQNFB"], "t": "Enjoy. When it's over, the exit is down by the screen."}, "usher/ush.locate.0.ogg": {"h": "8dae3f0a6f3e835f", "m": [3260, "Er0z3z0320grWQ52lMK2uvuytlieZ2yysTEACDEDCBAABz/5xuslqwy0wvuppuuupuvtyvxvyx0wkeVQIE"], "t": "Do you want me to take you to your seat, or are you all right on your own?"}, "usher/ush.locate.1.ogg": {"h": "a0ac737c32c018e3", "m": [2147, "Bp/44zsoeogghbXXOEBAAAF0vrqstqpnrdFTjcZZWyqPMMWbSOLKIC"], "t": "You know the way. I'll light up your seat for you."}, "usher/ush.noTicket.0.ogg": {"h": "b01017eefc97d178", "m": [3515, "Nr6yvsfWg06y32ysllNWe4YThQJGMgYUSZSEOEAAABCDCBC20v/ypSVX1vrfNuufcpiJXx0jKj1wnhpgdnkbYYMC"], "t": "Sorry, I'll need a ticket first. The box office is just over there."}, "usher/ush.noTicket.1.ogg": {"h": "5801f0a14cf853ac", "m": [6300, "L123yujrYCYTuZMlRLbaTjgcVQOHBEBAAABCCCAAE/zqeaasqbIgzzvsqnigOorbvpqjKWToZROHHINXUPEABBAAAAABCDCGJDCABCGGGGGGGIFADGGGGHGHHHGHHGGFDFGGFEDDCABGFEDEEFFEDDDKKLLLJG"], "t": "You'll need a ticket to go up. They'll sort you out at the box office."}, "server/srv.arrive.0.ogg": {"h": "8ae95651e6216e05", "m": [2056, "DIQr4/5oaYXUTbWJQWkjhiogQSGDABBPkdFMfkjfRiqdFQXZUOID"], "t": "Hi, you called? What can I get you?"}, "server/srv.arrive.1.ogg": {"h": "526cc59ddce329fc", "m": [1590, "Df7fzqbHUbabPFDBABPu252/zLLqxsjtpkcbWQIF"], "t": "Good evening. I'm here for your order."}, "server/srv.arrive.2.ogg": {"h": "9b284b5c063686d7", "m": [1660, "COmx254012y01pXgxiFSgkibRTw9/0hQEJFDAACDKI"], "t": "Hello! How can I help?"}, "server/srv.menu.0.ogg": {"h": "3c6d35c8c1069605", "m": [3074, "GiyJEXgtyywxjIFVjshHndrqolhtlaEUkvunLG0/xGRYkVJLiheSDDEFEEEFEG1vwlampkmicNDKG"], "t": "Popcorn, nachos, drinks, coffee. What would you like?"}, "server/srv.menu.1.ogg": {"h": "877df8befbd9ec27", "m": [2428, "FfoXk24+uPYgIau9jsz/r0hNHevxysREEFEGLlcVhkgjmjabaWosdJXYMFbME"], "t": "Would you like to order something, or do you want the tablet?"}, "server/srv.order.0.ogg": {"h": "1f53aeb4c47dede7", "m": [1066, "FVkl/6xiZPGEJYptz0tomjfWUIG"], "t": "Sure, one moment."}, "server/srv.order.1.ogg": {"h": "762738f62474c41f", "m": [5131, "DcqXZTUHEFCAUteHwx0/q05rPVgklhhZGMTaWVLIWJEEAABAAAABCCBCDBRv5+9+755uSJIbytYFJvxioijbSFDIIFEDDePZunnsqmhnkjcbbDFgkgeccffdWaIDDIOLJ"], "t": "Got it. I've got that right here on the cart."}, "server/srv.order.2.ogg": {"h": "d83485cbe0e67777", "m": [1640, "GKYaYYXVYXULXNWXWJDFDBAAAAAAAABBBBBUx/0Of"], "t": "Coming right up."}, "server/srv.hand.0.ogg": {"h": "0585733b7c07ff04", "m": [602, "DK5/3opfOgeZUPEA"], "t": "Here you go."}, "server/srv.hand.1.ogg": {"h": "af6acde206f7302a", "m": [1894, "DRs/40ppnjcXQGEEEGFg1rgpricUKFECAAABESq4glslfVJC"], "t": "There you are. Enjoy."}, "server/srv.hand.2.ogg": {"h": "e73a3f4af8b906c3", "m": [3057, "BPU2/2gJIgbZMFFGHGFbbb24uSoiLm3pWGGJjidVJGFAABFFEFEDDEFFDAABBBCBCCCBCBCJMLJIE"], "t": "Careful, the d